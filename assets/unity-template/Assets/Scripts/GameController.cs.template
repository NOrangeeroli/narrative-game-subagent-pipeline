using System;
using UnityEngine;

public class GameController : MonoBehaviour
{
    [Serializable] public class StoryData { public string title; public string start_node_id; public StoryNode[] nodes; }
    [Serializable] public class StoryNode { public string id; public string title; public string background_id; public Beat[] beats; public Choice[] choices; public bool is_terminal; }
    [Serializable] public class Beat { public string speaker; public string text; }
    [Serializable] public class Choice { public string label; public string target; }

    private StoryData story;
    private StoryNode current;
    private int beatIndex;
    private Vector2 scroll;

    private void Awake()
    {
        var asset = Resources.Load<TextAsset>("story");
        if (asset == null)
        {
            Debug.LogError("Missing Resources/story.json");
            return;
        }
        story = JsonUtility.FromJson<StoryData>(asset.text);
        GoTo(story.start_node_id);
    }

    private void GoTo(string nodeId)
    {
        current = null;
        beatIndex = 0;
        if (story == null || story.nodes == null) return;
        foreach (var node in story.nodes)
        {
            if (node.id == nodeId)
            {
                current = node;
                return;
            }
        }
        Debug.LogError("Missing story node: " + nodeId);
    }

    private void OnGUI()
    {
        GUI.color = Color.white;
        GUI.Box(new Rect(0, 0, Screen.width, Screen.height), "");
        if (story == null || current == null)
        {
            GUI.Label(new Rect(24, 24, 800, 40), "No story loaded.");
            return;
        }

        GUI.Label(new Rect(24, 20, Screen.width - 48, 40), story.title);

        var panel = new Rect(24, Screen.height - 260, Screen.width - 48, 236);
        GUI.Box(panel, "");
        GUILayout.BeginArea(new Rect(panel.x + 18, panel.y + 14, panel.width - 36, panel.height - 28));
        GUILayout.Label(current.title);
        var beats = current.beats ?? Array.Empty<Beat>();
        var beat = beats.Length > 0 ? beats[Math.Min(beatIndex, beats.Length - 1)] : new Beat { speaker = "Narrator", text = "..." };
        GUILayout.Label(beat.speaker ?? "Narrator");
        scroll = GUILayout.BeginScrollView(scroll, GUILayout.Height(92));
        GUILayout.Label(beat.text ?? "");
        GUILayout.EndScrollView();

        if (beatIndex < beats.Length - 1)
        {
            if (GUILayout.Button("Continue", GUILayout.Height(38))) beatIndex += 1;
        }
        else if (current.choices != null && current.choices.Length > 0)
        {
            foreach (var choice in current.choices)
            {
                if (GUILayout.Button(string.IsNullOrEmpty(choice.label) ? "Continue" : choice.label, GUILayout.Height(38)))
                {
                    GoTo(choice.target);
                    break;
                }
            }
        }
        else
        {
            GUILayout.Label("The End");
        }
        GUILayout.EndArea();
    }
}

