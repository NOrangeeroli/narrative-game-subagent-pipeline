# Background workflow provider configuration.
# Copy to .env or <run-root>/.env for local testing. Do not commit real keys.

# IMAGE_PROVIDER: ppio | imagegen | local-svg
IMAGE_PROVIDER=ppio
IMAGE_MODEL=gpt-image-2-text-to-image

# VIDEO_PROVIDER: ppio | none
VIDEO_PROVIDER=none
VIDEO_MODEL=veo-3.1-fast-generate-firstlastframe

# Keys are read from the environment. Put them here only for local uncommitted tests.
# PPIO_API_KEY=sk_...
# IMAGE_API_KEY=sk_...
# VIDEO_API_KEY=sk_...

# Optional PPIO tuning.
# IMAGE_QUALITY=medium
# IMAGE_HTTP_TIMEOUT_MS=180000
# IMAGE_ASSET_TIMEOUT_MS=240000
